{
  "name": "hello-fast",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // Keep the container's venv out of the bind-mounted workspace, so it never
  // clashes with the macOS .venv on the host (Linux vs macOS binaries).
  "containerEnv": {
    "VIRTUAL_ENV": "/home/vscode/.venv"
  },
  // PATH goes in remoteEnv: ${containerEnv:PATH} is only resolved there.
  "remoteEnv": {
    "PATH": "/home/vscode/.venv/bin:${containerEnv:PATH}"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "FastAPI", "onAutoForward": "openBrowser" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  },

  "remoteUser": "vscode"
}
